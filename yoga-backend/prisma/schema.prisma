// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum DurationType {
  MONTH
  DAYS
}

enum PriceType {
  US
  INR
}

enum PaymentStatus{
  PENDING
  COMPLETED
}

enum targetAudienceType {
  ALL
  ADMIN
  SUBSCRIBERS
  FREETRIAL
}

model User {
  id              String      @id @default(uuid())
  name            String
  email           String?
  phoneNumber     String      @unique
  role            Role        @default(USER)

  referralCode    String      @unique
  referredById    String?
  referredBy      User?       @relation("UserReferrals", fields: [referredById], references: [id])
  referrals       User[]      @relation("UserReferrals")
  payments        Payment[]
  referralPoints  Int         @default(0)

  otp             Int?
  otpExpire       DateTime?

  subscription    Subscription[]
  blogs           Blog[]
  attendance     Attendance[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model FreeTrialCampaign {
  id        String   @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}


model Subscription {
  id             String    @id @default(uuid())
  user           User      @relation(fields: [userId], references: [id])
  userId         String    

  plan           Plan      @relation(fields: [planId], references: [id])
  planId         String
  invoice        String?
  paymentId      String?     // link to payment record
  payment        Payment?   

  startDate      DateTime
  baseDuration   Int       
  extraDays      Int       @default(0)
  expiresAt      DateTime
  status         String    @default("active")
  attendance     Attendance[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Payment {
  id                  String         @id @default(uuid())
  razorpay_order_id   String?        @unique
  razorpay_payment_id String?        @unique
  razorpay_signature  String?
  
  userId              String
  user                User           @relation(fields: [userId], references: [id])

  planId              String?
  startDate           String?
  
  subscriptionId      String?        @unique
  subscription        Subscription?  @relation(fields: [subscriptionId], references: [id])

  amount              Int
  currency            String         @default("INR")
  paymentDate         DateTime?      @default(now())

  status              PaymentStatus  @default(PENDING)
  verified            Boolean        @default(false) // Admin can manually mark true
  verificationNote    String?        // Optional admin reason/note

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}


model Plan {
  id           String    @id @default(uuid())
  name         String    
  description  String
  inrPrice     Int?
  usdPrice     Int?
  orignalPriceInInr Int
  discount     String?
  duration     Int       // in days
  durationType DurationType 
  isFreeTrial  Boolean   @default(false)
  

  subscriptions Subscription[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Blog {
  id              String     @id @default(uuid())
  title           String
  img             String
  content         String     @db.Text
  author          User       @relation(fields: [authorId], references: [id])
  authorId        String
  createdAt       DateTime   @default(now())
}

model ScheduledMessage {
  id            Int      @id @default(autoincrement())
  templateName  String
  scheduledDate DateTime
  payload       Json
  targetAudience  String
  sent          Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


model YogaClass {
  id              String     @id @default(uuid())
  date            DateTime // date of class
  title           String
  focusArea       String
  videoLink       String @db.VarChar(1000)
  attendance     Attendance[]
  isActive        Boolean @default(true)
  createdAt       DateTime   @default(now())
}


model Attendance {
  id             String         @id @default(uuid())

  user           User           @relation(fields: [userId], references: [id])
  userId         String

  subscription   Subscription   @relation(fields: [subscriptionId], references: [id])
  subscriptionId String

  yogaClass      YogaClass      @relation(fields: [yogaClassId], references: [id])
  yogaClassId    String

  attended       Boolean        @default(false)
  attendedAt     DateTime?

  createdAt      DateTime       @default(now())

  @@unique([userId, yogaClassId]) // Ensure only 1 attendance per user per class
}

model CommonLink {
  id         String   @id @default(uuid())
  link       String
  ref        String
  startDate  DateTime
  expiryDate DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Offer {
  id        String   @id @default(uuid())
  text      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Gender {
  MALE
  FEMALE
}

enum TShirtSize {
  S
  M
  L
  XL
  XXL
}

enum RetreatPlan {
  TWIN_SHARING_SUPERIOR
  SINGLE_OCCUPANCY_SUPERIOR
  TWIN_SHARING_JACUZZI
  SINGLE_OCCUPANCY_JACUZZI
}

enum EventPaymentStatus {
  PENDING
  PAID
}

model EventRegistration {
  id                String             @id @default(uuid())
  fullName          String
  gender            Gender
  age               Int
  mobileNumber      String
  email             String
  city              String
  tShirtSize        TShirtSize
  plan              RetreatPlan
  orderId           String?
  paymentId         String?
  status            EventPaymentStatus @default(PENDING)
  invoice           String?
  earlyBirdApplied  Boolean            @default(false)
  amountPaid        Int?               // discounted per-person amount in INR
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}


model Lead {
  id          String   @id @default(uuid())
  srNo        Int?
  refCode     String?  @unique  // e.g. "YS/1"
  name        String?
  phoneNumber String   @unique
  remarks     String?
  status      LeadStatus @default(NEW)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  CONVERTED
  NOT_INTERESTED
}

model OverseasInquiry {
  id          String   @id @default(uuid())
  name        String
  country     String
  timings     String
  whatsapp    String
  email       String
  joiningDate DateTime
  healthGoal  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DieticianSessionRegistration {
  id              String   @id @default(uuid())
  name            String
  phone           String
  email           String
  promocode       String?
  challenge       String?
  amount          Int
  orderId         String?  @unique
  paymentId       String?  @unique
  signature       String?
  status          String   @default("PENDING") // PENDING, PAID, FAILED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DieticianSessionConfig {
  id        String   @id @default("dietician-config")
  price     Int      @default(149)
  slotsLeft Int      @default(10)
  updatedAt DateTime @updatedAt
}
